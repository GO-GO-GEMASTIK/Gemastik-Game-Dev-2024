"Ucing": {
"case_sensitive": true,
"color": Color(0.996094, 0.987886, 0.78598, 1),
"extra": "",
"name": "Ucing",
"text": "Ucing merupakan seekor kucing berjenis \"Balinese Cat\". Jenis kucing ini dikenal dengan kecerdasannya, sifat yang ingin tahu dan suka bermain. Kamu bisa tau jenis ini dengan melihat corak di wajahnya yang mencolok seperti Ucing!
",
"title": "Ucing"
}
